{
  "name": "@a11y-agent/core",
  "version": "0.1.0",
  "description": "Framework-independent accessibility scanning, evidence normalization, comparison, and verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smukh/a11y-agent-skills.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/smukh/a11y-agent-skills#readme",
  "bugs": {
